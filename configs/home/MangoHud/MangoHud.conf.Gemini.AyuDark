################### Ayu Dark MangoHud Config ###################

no_display

legacy_layout=false

# Header
custom_text_center=luna

# Modern Glass Aesthetics
background_alpha=0.85
round_corners=12
background_color=0B0E14   # Ayu Dark Background

font_size=24
text_color=E6B450         # Ayu Accent Gold/Orange
position=top-right

table_columns=3

# GPU Section
gpu_text=GPU
gpu_stats
gpu_load_change
gpu_load_value=50,90
gpu_load_color=39BAE6,FFB454,FF3333   # Cyan -> Amber -> Coral Red
gpu_temp
gpu_color=39BAE6                      # Ayu Blue/Cyan

# CPU Section
cpu_text=CPU
cpu_stats
cpu_load_change
cpu_load_value=50,90
cpu_load_color=7FD962,FFB454,FF3333   # Green -> Amber -> Coral Red
cpu_temp
cpu_color=7FD962                      # Ayu Green

# System Stats
io_stats
io_read
io_write
io_color=59C2FF
vram
vram_color=D2A6FF                     # Ayu Purple
ram
ram_color=D2A6FF                      # Ayu Purple

# Performance Metrics
fps

# Environment Info
custom_text_center= 
custom_text=Fedora 44 KDE
wine
wine_color=BFBDB6                     # Ayu Foreground Light Gray
engine_version
engine_color=5C6773                   # Ayu Muted Gray
vulkan_driver

# Frametime Gradient
frame_timing
frametime_color=7FD962,FFB454,FF3333

fps_limit_method=late
toggle_fps_limit=Shift_L+F1
fps_limit=0

gpu_name
resolution
refresh_rate
gamemode
display_server

output_folder=/home/daniel
log_duration=30
autostart_log=0
log_interval=100
toggle_logging=Shift_L+F2

blacklist=pamac-manager,lact,ghb,bitwig-studio,ptyxis,yumex