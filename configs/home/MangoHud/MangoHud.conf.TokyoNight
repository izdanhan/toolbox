################### Tokyo Night v1.0 ###################

legacy_layout=false

# Header & Wine
custom_text_center=nibiru

# Glass Aesthetics - Tokyo Night bg
background_alpha=0.55
round_corners=15
background_color=1a1b26   # Tokyo Night bg

font_size=24
text_color=c0caf5         # Tokyo Night fg
position=top-left

# pci_dev=0:c3:00.0
table_columns=3

# Gamescope only
# fsr

# GPU Section - Blue
gpu_text=GPU
gpu_stats
gpu_load_change
gpu_load_value=50,90
gpu_load_color=9ece6a,e0af68,f7768e
gpu_temp
gpu_color=7aa2f7         # blue

# CPU Section - Magenta
cpu_text=CPU
cpu_stats
cpu_load_change
cpu_load_value=50,90
cpu_load_color=9ece6a,e0af68,f7768e
cpu_temp
cpu_color=bb9af7         # magenta

# System Stats
io_stats
io_read
io_write
io_color=e0af68           # yellow
vram
vram_color=7dcfff         # light cyan
ram
ram_color=9ece6a           # green
# network
# network_color=808080

# Performance Metrics
fps

# Proton
custom_text_center= 
custom_text=CachyOS KDE Plasma 6.8
wine
wine_color=9d7cd8         # purple
engine_version
engine_color=565f89       # comment gray
vulkan_driver

# Frametime - Tokyo Night traffic light
frame_timing
frametime_color=9ece6a,e0af68,f7768e

fps_limit_method=late
toggle_fps_limit=Shift_L+F1
fps_limit=0

gpu_name
resolution
refresh_rate
gamemode
display_server

# time
# time_format=%H:%M

output_folder=/home/daniel
log_duration=30
autostart_log=0
log_interval=100
toggle_logging=Shift_L+F2

blacklist=pamac-manager,lact,ghb,bitwig-studio,ptyxis,yumex,EDLaunch.exe
