# Rendering & Hardware Acceleration (RTX 3080 + Vulkan)
profile=high-quality
vo=gpu-next
gpu-api=vulkan
gpu-context=waylandvk
hwdec=nvdec,vulkan

# Frame pacing & debanding
video-sync=display-tempo
deband=yes

# Audio (clean stereo for offline viewing / headphones)
audio-channels=stereo
audio-normalize-downmix=yes

# Subtitles & OSD
slang=fi,en
sub-auto=fuzzy
sub-file-paths=subs:subtitle:subtitles
sub-codepage=utf8
sub-font-size=42
sub-color='#ebdbb2'
sub-border-color='#282828'
sub-border-size=2
blend-subtitles=video
sid=auto

osd-font-size=26
osd-scale=1.1
osd-level=1
osd-color='#ebdbb2'

# Playback & Session Behavior
keepaspect-window=yes
save-position-on-quit=yes
